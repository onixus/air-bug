/target/
.DS_Store
# Local captures / credentials belong outside version control.
# Synthetic tests/fixtures captures are intentionally tracked.
*.log
/android/.gradle/
/android/**/build/
/android/local.properties
/android/app/src/main/jniLibs/
/android/.android-home/

# Opt-in persistent PMK key material (recommended cache extension).
*.pmk-cache

# Generated bytecode and real captures are local-only; synthetic fixtures are public.
__pycache__/
*.py[cod]
*.pcap
*.pcapng
*.cap
!tests/fixtures/*.pcap
!tests/fixtures/*.pcapng
!android/app/src/main/assets/demo/*.pcap
!android/app/src/androidTest/assets/interop/*.pcap
